{
  "name": "minecraft-ondemand",
  "version": "1.0.0",
  "bin": {
    "cdk": "bin/cdk.js"
  },
  "scripts": {
    "prebuild": "pnpm i --frozen-lockfile",
    "build": "pnpm dlx aws-cdk bootstrap",
    "deploy": "pnpm dlx aws-cdk deploy --all",
    "destroy": "pnpm dlx aws-cdk destroy --all",
    "typecheck": "tsc --noEmit --watch",
    "diff": "pnpm dlx aws-cdk diff"
  },
  "devDependencies": {
    "@types/jest": "^26.0.10",
    "@types/node": "22.20.5",
    "dotenv": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "execa": "^5.1.1",
    "source-map-support": "^0.5.16"
  }
}
